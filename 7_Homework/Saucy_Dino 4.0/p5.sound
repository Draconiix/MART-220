13401 1 8 1C11.866 1 15 4.13401 15 8Z" fill-rule=evenodd clip-rule=evenodd /></svg></div><input class="bg-transparent focus:outline-0 lg:py-[8px] md:py-[4px] peer pl-gutter-md placeholder-accent-type-color py-[6px] rounded-[20px] w-full" id=search-term aria-label="Search through site content" name=term type=search placeholder=Search required> <button class="absolute invisible lg:py-[13px] peer-valid:visible pl-[22px] pr-[12px] py-[11px] right-0 top-0" aria-label="Submit search" type=submit><svg fill=none viewBox="0 0 21 11" height=11 width=21><path fill=currentColor d="M15.3535 0.146446L20.707 5.5L15.3535 10.8536C15.1582 11.0488 14.8416 11.0488 14.6464 10.8536C14.4511 10.6583 14.4511 10.3417 14.6464 10.1464L18.7928 6L5 6C4.72386 6 4.5 5.77614 4.5 5.5C4.5 5.22386 4.72386 5 5 5L18.7928 5L14.6464 0.853553C14.4511 0.658291 14.4511 0.341708 14.6464 0.146446C14.8416 -0.0488155 15.1582 -0.0488155 15.3535 0.146446Z"/></svg></button></form></div></div></div><header><div class="bg-accent-color content-grid-simple h-[50vh] lg:pt-4xl md:px-lg min-h-[350px] pb-md pt-5xl px-5 text-accent-type-color"><h1 class="col-span-full mb-5 whitespace-pre-line">p5.sound Reference</h1><p class="!mt-0 col-span-2 mb-3xl text-h3">Extend p5.js with Web Audio functionality including audio input, playback, analysis and synthesis.</div></header><main class=relative id=main-content><div id=processing-banner style="margin-left: var(--nav-offset-x);"></div><div class="md:px-lg pb-lg pt-sm px-5"><div class=rendered-markdown><p>Looking for the main p5.js reference? Go to <a href=/reference/>the reference</a>!</div></div><div class=mx-0><astro-island uid=ZN8ljy ssr="" renderer-url=/_astro/client.ChxuPEbT.js props='{"categoryData":[1,[[0,{"name":[0,"p5.sound"],"subcats":[1,[[0,{"name":[0],"entry":[0],"entries":[1,[]]}],[0,{"name":[0],"entry":[0],"entries":[1,[[0,{"id":[0,"en/p5.PeakDetect/isDetected.mdx"],"slug":[0,"en/p5peakdetect/isdetected"],"body":[0,"\n\n# isDetected\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"isDetected"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>isDetected is set to true when a peak is detected.</p>\n"],"line":[0,10419],"path":[0,"p5.PeakDetect/isDetected"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/createConvolver.mdx"],"slug":[0,"en/p5/createconvolver"],"body":[0,"\n\n# createConvolver\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"createConvolver()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Create a p5.Convolver. Accepts a path to a soundfile\nthat will be used to generate an impulse response.</p>\n"],"line":[0,8885],"params":[1,[[0,{"name":[0,"path"],"description":[0,"<p>path to a sound file</p>\n"],"type":[0,"String"]}],[0,{"name":[0,"callback"],"description":[0,"<p>function to call if loading is successful.\n                              The object will be passed in as the argument\n                              to the callback function.</p>\n"],"type":[0,"Function"],"optional":[0,true]}],[0,{"name":[0,"errorCallback"],"description":[0,"<p>function to call if loading is not successful.\n                              A custom error will be passed in as the argument\n                              to the callback function.</p>\n"],"type":[0,"Function"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,""],"type":[0,"p5.Convolver"]}],"example":[1,[[0,"\n<div><code>\nlet cVerb, sound;\nfunction preload() {\n  // We have both MP3 and OGG versions of all sound assets\n  soundFormats(&apos;ogg&apos;, &apos;mp3&apos;);\n\n  // Try replacing &apos;bx-spring&apos; with other soundfiles like\n  // &apos;concrete-tunnel&apos; &apos;small-plate&apos; &apos;drum&apos; &apos;beatbox&apos;\n  cVerb = createConvolver(&apos;/assets/bx-spring.mp3&apos;);\n\n  // Try replacing &apos;Damscray_DancingTiger&apos; with\n  // &apos;beat&apos;, &apos;doorbell&apos;, lucky_dragons_-_power_melody&apos;\n  sound = loadSound(&apos;/assets/Damscray_DancingTiger.mp3&apos;);\n}\n\nfunction setup() {\n  let cnv = createCanvas(100, 100);\n  cnv.mousePressed(playSound);\n  background(220);\n  text(&apos;tap to play&apos;, 20, 20);\n\n  // disconnect from main output...\n  sound.disconnect();\n\n  // ...and process with cVerb\n  // so that we only hear the convolution\n  cVerb.process(sound);\n}\n\nfunction playSound() {\n  sound.play();\n}\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5/createConvolver"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/freqToMidi.mdx"],"slug":[0,"en/p5/freqtomidi"],"body":[0,"\n\n# freqToMidi\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"freqToMidi()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns the closest MIDI note value for\na given frequency.</p>\n"],"line":[0,825],"params":[1,[[0,{"name":[0,"frequency"],"description":[0,"<p>A freqeuncy, for example, the \"A\"\n                           above Middle C is 440Hz</p>\n"],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"MIDI note value"],"type":[0,"Number"]}],"isConstructor":[0,false],"path":[0,"p5/freqToMidi"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/getAudioContext.mdx"],"slug":[0,"en/p5/getaudiocontext"],"body":[0,"\n\n# getAudioContext\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"getAudioContext()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns the Audio Context for this sketch. Useful for users\nwho would like to dig deeper into the <a target=\"_blank\" href=\"http://webaudio.github.io/web-audio-api/\">Web Audio API\n</a>.</p>\n\n<p>Some browsers require users to startAudioContext\nwith a user gesture, such as touchStarted in the example below.</p>"],"line":[0,159],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"AudioContext for this sketch"],"type":[0,"Object"]}],"example":[1,[[0,"\n<div><code>\n function draw() {\n   background(255);\n   textAlign(CENTER);\n\n   if (getAudioContext().state !== &apos;running&apos;) {\n     text(&apos;click to start audio&apos;, width/2, height/2);\n   } else {\n     text(&apos;audio is enabled&apos;, width/2, height/2);\n   }\n }\n\n function touchStarted() {\n   if (getAudioContext().state !== &apos;running&apos;) {\n     getAudioContext().resume();\n   }\n   var synth = new p5.MonoSynth();\n   synth.play(&apos;A4&apos;, 0.5, 0, 0.2);\n }\n\n</div></code>"]]],"isConstructor":[0,false],"path":[0,"p5/getAudioContext"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/getOutputVolume.mdx"],"slug":[0,"en/p5/getoutputvolume"],"body":[0,"\n\n# getOutputVolume\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"getOutputVolume()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns a number representing the output volume for sound\nin this sketch.</p>\n"],"line":[0,726],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"Output volume for sound in this sketch.\n                 Should be between 0.0 (silence) and 1.0."],"type":[0,"Number"]}],"isConstructor":[0,false],"path":[0,"p5/getOutputVolume"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/loadSound.mdx"],"slug":[0,"en/p5/loadsound"],"body":[0,"\n\n# loadSound\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"loadSound()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>loadSound() returns a new p5.SoundFile from a specified\npath. If called during preload(), the p5.SoundFile will be ready\nto play in time for setup() and draw(). If called outside of\npreload, the p5.SoundFile will not be ready immediately, so\nloadSound accepts a callback as the second parameter. Using a\n<a href=\"https://github.com/processing/p5.js/wiki/Local-server/\">\nlocal server</a> is recommended when loading external files.</p>\n"],"line":[0,2946],"params":[1,[[0,{"name":[0,"path"],"description":[0,"<p>Path to the sound file, or an array with\n                                  paths to soundfiles in multiple formats\n                                  i.e. [&apos;sound.ogg&apos;, &apos;sound.mp3&apos;].\n                                  Alternately, accepts an object: either\n                                  from the HTML5 File API, or a p5.File.</p>\n"],"type":[0,"String|Array"]}],[0,{"name":[0,"successCallback"],"description":[0,"<p>Name of a function to call once file loads</p>\n"],"type":[0,"Function"],"optional":[0,true]}],[0,{"name":[0,"errorCallback"],"description":[0,"<p>Name of a function to call if there is\n                                    an error loading the file.</p>\n"],"type":[0,"Function"],"optional":[0,true]}],[0,{"name":[0,"whileLoading"],"description":[0,"<p>Name of a function to call while file is loading.\n                               This function will receive the percentage loaded\n                               so far, from 0.0 to 1.0.</p>\n"],"type":[0,"Function"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"Returns a p5.SoundFile"],"type":[0,"SoundFile"]}],"example":[1,[[0,"\n<div><code>\nlet mySound;\nfunction preload() {\n  soundFormats(&apos;mp3&apos;, &apos;ogg&apos;);\n  mySound = loadSound(&apos;/assets/doorbell&apos;);\n}\n\nfunction setup() {\n  let cnv = createCanvas(100, 100);\n  cnv.mousePressed(canvasPressed);\n  background(220);\n  text(&apos;tap here to play&apos;, 10, 20);\n}\n\nfunction canvasPressed() {\n  // playing a sound file on a user gesture\n  // is equivalent to `userStartAudio()`\n  mySound.play();\n}\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5/loadSound"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/midiToFreq.mdx"],"slug":[0,"en/p5/miditofreq"],"body":[0,"\n\n# midiToFreq\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"midiToFreq()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns the frequency value of a MIDI note value.\nGeneral MIDI treats notes as integers where middle C\nis 60, C# is 61, D is 62 etc. Useful for generating\nmusical frequencies with oscillators.</p>\n"],"line":[0,841],"params":[1,[[0,{"name":[0,"midiNote"],"description":[0,"<p>The number of a MIDI note</p>\n"],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"Frequency value of the given MIDI note"],"type":[0,"Number"]}],"example":[1,[[0,"\n<div><code>\nlet midiNotes = [60, 64, 67, 72];\nlet noteIndex = 0;\nlet midiVal, freq;\n\nfunction setup() {\n  let cnv = createCanvas(100, 100);\n  cnv.mousePressed(startSound);\n  osc = new p5.TriOsc();\n  env = new p5.Envelope();\n}\n\nfunction draw() {\n  background(220);\n  text(&apos;tap to play&apos;, 10, 20);\n  if (midiVal) {\n    text(&apos;MIDI: &apos; + midiVal, 10, 40);\n    text(&apos;Freq: &apos; + freq, 10, 60);\n  }\n}\n\nfunction startSound() {\n  // see also: userStartAudio();\n  osc.start();\n\n  midiVal = midiNotes[noteIndex % midiNotes.length];\n  freq = midiToFreq(midiVal);\n  osc.freq(freq);\n  env.ramp(osc, 0, 1.0, 0);\n\n  noteIndex++;\n}\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5/midiToFreq"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/outputVolume.mdx"],"slug":[0,"en/p5/outputvolume"],"body":[0,"\n\n# outputVolume\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"outputVolume()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Scale the output of all sound in this sketch</p>\nScaled between 0.0 (silence) and 1.0 (full volume).\n1.0 is the maximum amplitude of a digital sound, so multiplying\nby greater than 1.0 may cause digital distortion. To\nfade, provide a <code>rampTime</code> parameter. For more\ncomplex fades, see the Envelope class.\n\n<p>Alternately, you can pass in a signal source such as an\noscillator to modulate the amplitude with an audio signal.</p>\n<p><b>How This Works</b>: When you load the p5.sound module, it\ncreates a single instance of p5sound. All sound objects in this\nmodule output to p5sound before reaching your computer&apos;s output.\nSo if you change the amplitude of p5sound, it impacts all of the\nsound in this module.</p>\n\n<p>If no value is provided, returns a Web Audio API Gain Node</p>"],"line":[0,738],"params":[1,[[0,{"name":[0,"volume"],"description":[0,"<p>Volume (amplitude) between 0.0\n                                   and 1.0 or modulating signal/oscillator</p>\n"],"type":[0,"Number|Object"]}],[0,{"name":[0,"rampTime"],"description":[0,"<p>Fade for t seconds</p>\n"],"type":[0,"Number"],"optional":[0,true]}],[0,{"name":[0,"timeFromNow"],"description":[0,"<p>Schedule this event to happen at\n                               t seconds in the future</p>\n"],"type":[0,"Number"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5/outputVolume"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/sampleRate.mdx"],"slug":[0,"en/p5/samplerate"],"body":[0,"\n\n# sampleRate\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"sampleRate()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns a number representing the sample rate, in samples per second,\nof all sound objects in this audio context. It is determined by the\nsampling rate of your operating system&apos;s sound card, and it is not\ncurrently possile to change.\nIt is often 44100, or twice the range of human hearing.</p>\n"],"line":[0,811],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"samplerate samples per second"],"type":[0,"Number"]}],"isConstructor":[0,false],"path":[0,"p5/sampleRate"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/saveSound.mdx"],"slug":[0,"en/p5/savesound"],"body":[0,"\n\n# saveSound\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"saveSound()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Save a p5.SoundFile as a .wav file. The browser will prompt the user\nto download the file to their device.\nFor uploading audio to a server, use\n<a href=\"/docs/reference/p5.SoundFile/saveBlob/\"><code>p5.SoundFile.saveBlob</code></a>.</p>\n"],"line":[0,1145],"params":[1,[[0,{"name":[0,"soundFile"],"description":[0,"<p>p5.SoundFile that you wish to save</p>\n"],"type":[0,"p5.SoundFile"]}],[0,{"name":[0,"fileName"],"description":[0,"<p>name of the resulting .wav file.</p>\n"],"type":[0,"String"]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5/saveSound"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/setBPM.mdx"],"slug":[0,"en/p5/setbpm"],"body":[0,"\n\n# setBPM\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"setBPM()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Set the global tempo, in beats per minute, for all\np5.Parts. This method will impact all active p5.Parts.</p>\n"],"line":[0,9084],"params":[1,[[0,{"name":[0,"BPM"],"description":[0,"<p>Beats Per Minute</p>\n"],"type":[0,"Number"]}],[0,{"name":[0,"rampTime"],"description":[0,"<p>Seconds from now</p>\n"],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5/setBPM"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/soundFormats.mdx"],"slug":[0,"en/p5/soundformats"],"body":[0,"\n\n# soundFormats\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"soundFormats()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>List the SoundFile formats that you will include. LoadSound\nwill search your directory for these extensions, and will pick\na format that is compatable with the client&apos;s web browser.\n<a href=\"http://media.io/\">Here</a> is a free online file\nconverter.</p>\n"],"line":[0,925],"params":[1,[[0,{"name":[0,"formats"],"description":[0,"<p>i.e. &apos;mp3&apos;, &apos;wav&apos;, &apos;ogg&apos;</p>\n"],"type":[0,"String"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"example":[1,[[0,"\n<div><code>\nfunction preload() {\n  // set the global sound formats\n  soundFormats(&apos;mp3&apos;, &apos;ogg&apos;);\n\n  // load either beatbox.mp3, or .ogg, depending on browser\n  mySound = loadSound(&apos;/assets/beatbox.mp3&apos;);\n}\n\nfunction setup() {\n     let cnv = createCanvas(100, 100);\n     background(220);\n     text(&apos;sound loaded! tap to play&apos;, 10, 20, width - 20);\n     cnv.mousePressed(function() {\n       mySound.play();\n     });\n   }\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5/soundFormats"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/soundOut.mdx"],"slug":[0,"en/p5/soundout"],"body":[0,"\n\n# soundOut\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"soundOut"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p><code>p5.soundOut</code> is the p5.sound final output bus. It sends output to\nthe destination of this window&apos;s web audio context. It contains\nWeb Audio API nodes including a dyanmicsCompressor (<code>.limiter</code>),\nand Gain Nodes for <code>.input</code> and <code>.output</code>.</p>\n"],"line":[0,782],"itemtype":[0,"property"],"class":[0,"p5"],"isConstructor":[0,false],"path":[0,"p5/soundOut"]}],"render":[0,null]}],[0,{"id":[0,"en/p5/userStartAudio.mdx"],"slug":[0,"en/p5/userstartaudio"],"body":[0,"\n\n# userStartAudio\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"userStartAudio()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>It is not only a good practice to give users control over starting\naudio. This policy is enforced by many web browsers, including iOS and\n<a href=\"https://goo.gl/7K7WLu/\" title=\"Google Chrome&apos;s autoplay\npolicy\">Google Chrome</a>, which create the Web Audio API&apos;s\n<a href=\"https://developer.mozilla.org/en-US/docs/Web/API/AudioContext/\" title=\"Audio Context @ MDN\">Audio Context</a>\nin a suspended state.</p>\n\n<p>In these browser-specific policies, sound will not play until a user\ninteraction event (i.e. <code>mousePressed()</code>) explicitly resumes\nthe AudioContext, or starts an audio node. This can be accomplished by\ncalling <code>start()</code> on a <code>p5.Oscillator</code>,\n<code> play()</code> on a <code>p5.SoundFile</code>, or simply\n<code>userStartAudio()</code>.</p>\n\n<p><code>userStartAudio()</code> starts the AudioContext on a user\ngesture. The default behavior will enable audio on any\nmouseUp or touchEnd event. It can also be placed in a specific\ninteraction function, such as <code>mousePressed()</code> as in the\nexample below. This method utilizes\n<a href=\"https://github.com/tambien/StartAudioContext/\">StartAudioContext\n</a>, a library by Yotam Mann (MIT Licence, 2016).</p>"],"line":[0,198],"params":[1,[[0,{"name":[0,"elements"],"description":[0,"<p>This argument can be an Element,\n                              Selector String, NodeList, p5.Element,\n                              jQuery Element, or an Array of any of those.</p>\n"],"type":[0,"Element|Array"],"optional":[0,true]}],[0,{"name":[0,"callback"],"description":[0,"<p>Callback to invoke when the AudioContext\n                              has started</p>\n"],"type":[0,"Function"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5"],"chainable":[0,false],"return":[0,{"description":[0,"Returns a Promise that resolves when\n                                     the AudioContext state is &apos;running&apos;"],"type":[0,"Promise"]}],"example":[1,[[0,"\n<div><code>\nfunction setup() {\n  // mimics the autoplay policy\n  getAudioContext().suspend();\n\n  let mySynth = new p5.MonoSynth();\n\n  // This won&apos;t play until the context has resumed\n  mySynth.play(&apos;A6&apos;);\n}\nfunction draw() {\n  background(220);\n  textAlign(CENTER, CENTER);\n  text(getAudioContext().state, width/2, height/2);\n}\nfunction mousePressed() {\n  userStartAudio();\n}\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5/userStartAudio"]}],"render":[0,null]}]]]}],[0,{"name":[0,"p5.Amplitude"],"entry":[0,{"id":[0,"en/p5.sound/p5.Amplitude.mdx"],"slug":[0,"en/p5sound/p5amplitude"],"body":[0,"\n\n# p5.Amplitude\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.Amplitude"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Amplitude.js"],"description":[0,"Get the current volume of a sound."],"line":[0,10],"params":[1,[[0,{"name":[0,"smoothing"],"description":[0,"Smooth the amplitude analysis by averaging with the last analysis frame. 0.0 is no time averaging with the last analysis frame."],"type":[0,"Number"],"optional":[0,true]}]]],"chainable":[0,false],"example":[1,[[0,"\n<div>\n<code>\nlet sound, amp, cnv;\n  \nfunction preload() {\n  //replace this sound with something local with rights to distribute\n  sound = loadSound(&apos;//assets/Damscray_DancingTiger.mp3&apos;);\n}\n\nfunction setup() {\n  cnv = createCanvas(100, 100);\n  cnv.mousePressed(playSound);\n  textAlign(CENTER);\n  fill(255);\n  amp = new p5.Amplitude();\n  sound.connect(amp);\n}\n\nfunction playSound() {\n  sound.play();\n}\n\nfunction draw() {\n  let level = amp.getLevel();\n  level = map(level, 0, 0.2, 0, 255);\n  background(level, 0, 0);\n  text(&apos;tap to play&apos;, width/2, 20);\n  describe(&apos;The color of the background changes based on the amplitude of the sound.&apos;);\n}\n</code>\n</div>"]]],"methods":[0,{"setInput":[0,{"description":[0,"Connect an audio source to the amplitude object."],"path":[0,"p5.Amplitude/setInput"]}],"getLevel":[0,{"description":[0,"Get the current amplitude value of a sound."],"path":[0,"p5.Amplitude/getLevel"]}],"toggleNormalize":[0,{"description":[0,"<p>Determines whether the results of Amplitude.process() will be\nNormalized. To normalize, Amplitude finds the difference the\nloudest reading it has processed and the maximum amplitude of\n1.0. Amplitude adds this difference to all values to produce\nresults that will reliably map between 0.0 and 1.0. However,\nif a louder moment occurs, the amount that Normalize adds to\nall the values will change. Accepts an optional boolean parameter\n(true or false). Normalizing is off by default.</p>\n"],"path":[0,"p5.Amplitude/toggleNormalize"]}],"smooth":[0,{"description":[0,"Get the current amplitude value of a sound."],"path":[0,"p5.Amplitude/smooth"]}]}],"isConstructor":[0,true],"path":[0,"p5.sound/p5.Amplitude"]}],"render":[0,null]}],"entries":[1,[[0,{"id":[0,"en/p5.Amplitude/getLevel.mdx"],"slug":[0,"en/p5amplitude/getlevel"],"body":[0,"\n\n# getLevel\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"getLevel()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Amplitude.js"],"description":[0,"Get the current amplitude value of a sound."],"line":[0,63],"itemtype":[0,"method"],"class":[0,"p5.Amplitude"],"chainable":[0,false],"return":[0,{"description":[0,"Amplitude level (volume) of a sound."],"type":[0,"Number"]}],"isConstructor":[0,false],"path":[0,"p5.Amplitude/getLevel"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Amplitude/setInput.mdx"],"slug":[0,"en/p5amplitude/setinput"],"body":[0,"\n\n# setInput\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"setInput()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Amplitude.js"],"description":[0,"Connect an audio source to the amplitude object."],"line":[0,53],"params":[1,[[0,{"name":[0,"input"],"description":[0,"- An object that has audio output."],"type":[0,"Object"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Amplitude"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Amplitude/setInput"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Amplitude/smooth.mdx"],"slug":[0,"en/p5amplitude/smooth"],"body":[0,"\n\n# smooth\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"smooth()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Amplitude.js"],"description":[0,"Get the current amplitude value of a sound."],"line":[0,73],"params":[1,[[0,{"name":[0,"Smooth"],"description":[0,"Amplitude analysis by averaging with the last analysis frame. Off by default."],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Amplitude"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Amplitude/smooth"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Amplitude/toggleNormalize.mdx"],"slug":[0,"en/p5amplitude/togglenormalize"],"body":[0,"\n\n# toggleNormalize\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"toggleNormalize()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Determines whether the results of Amplitude.process() will be\nNormalized. To normalize, Amplitude finds the difference the\nloudest reading it has processed and the maximum amplitude of\n1.0. Amplitude adds this difference to all values to produce\nresults that will reliably map between 0.0 and 1.0. However,\nif a louder moment occurs, the amount that Normalize adds to\nall the values will change. Accepts an optional boolean parameter\n(true or false). Normalizing is off by default.</p>\n"],"line":[0,3264],"params":[1,[[0,{"name":[0,"boolean"],"description":[0,"<p>set normalize to true (1) or false (0)</p>\n"],"type":[0,"Boolean"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.Amplitude"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Amplitude/toggleNormalize"]}],"render":[0,null]}]]]}],[0,{"name":[0,"p5.AudioIn"],"entry":[0,{"id":[0,"en/p5.sound/p5.AudioIn.mdx"],"slug":[0,"en/p5sound/p5audioin"],"body":[0,"\n\n# p5.AudioIn\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.AudioIn"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/AudioIn.js"],"description":[0,"Get sound from an input source, typically a computer microphone."],"line":[0,11],"chainable":[0,false],"example":[1,[[0,"\n<div>\n<code>\nlet mic, delay, filter;\n\nfunction setup() {\n  let cnv = createCanvas(100, 100);\n  cnv.mousePressed(startMic);\n  background(220);\n  \n  mic = new p5.AudioIn();\n  delay = new p5.Delay(0.74, 0.1);\n  filter = new p5.Biquad(600, \"bandpass\");\n  \n  mic.disconnect();\n  mic.connect(delay);\n  delay.disconnect();\n  delay.connect(filter);\n  \n  textAlign(CENTER);\n  textWrap(WORD);\n  textSize(10);\n  text(&apos;click to open mic, watch out for feedback&apos;, 0, 20, 100);\n  describe(&apos;a sketch that accesses the user\\&apos;s microphone and connects it to a delay line.&apos;)\n}\n\nfunction startMic() {\n  mic.start();\n}\n\nfunction draw() {\n  d = map(mouseX, 0, width, 0.0, 0.5);\n  delay.delayTime(d);\n}\n</code>\n</div>"]]],"methods":[0,{"start":[0,{"description":[0,"Start the audio input."],"path":[0,"p5.AudioIn/start"]}],"stop":[0,{"description":[0,"Stop the audio input."],"path":[0,"p5.AudioIn/stop"]}],"connect":[0,{"description":[0,"<p>Connect to an audio unit. If no parameter is provided, will\nconnect to the main output (i.e. your speakers).<br/></p>\n"],"path":[0,"p5.AudioIn/connect"]}],"disconnect":[0,{"description":[0,"<p>Disconnect the AudioIn from all audio units. For example, if\nconnect() had been called, disconnect() will stop sending\nsignal to your speakers.<br/></p>\n"],"path":[0,"p5.AudioIn/disconnect"]}],"getLevel":[0,{"description":[0,"<p>Read the Amplitude (volume level) of an AudioIn. The AudioIn\nclass contains its own instance of the Amplitude class to help\nmake it easy to get a microphone&apos;s volume level. Accepts an\noptional smoothing value (0.0 < 1.0). <em>NOTE: AudioIn must\n.start() before using .getLevel().</em><br/></p>\n"],"path":[0,"p5.AudioIn/getLevel"]}],"amp":[0,{"description":[0,"Set amplitude (volume) of a mic input between 0 and 1.0."],"path":[0,"p5.AudioIn/amp"]}],"getSources":[0,{"description":[0,"<p>Returns a list of available input sources. This is a wrapper\nfor <a href=\"https://developer.mozilla.org/\nen-US/docs/Web/API/MediaDevices/enumerateDevices/\" target=\"_blank\">\nMediaDevices.enumerateDevices() - Web APIs | MDN</a>\nand it returns a Promise.</p>\n"],"path":[0,"p5.AudioIn/getSources"]}],"setSource":[0,{"description":[0,"<p>Set the input source. Accepts a number representing a\nposition in the array returned by getSources().\nThis is only available in browsers that support\n <a href=\"https://developer.mozilla.org/\n en-US/docs/Web/API/MediaDevices/enumerateDevices/\" target=\"_blank\">\n navigator.mediaDevices.enumerateDevices()</a></p>\n"],"path":[0,"p5.AudioIn/setSource"]}]}],"properties":[0,{"input":[0,{"description":[0,""],"path":[0,"p5.AudioIn/input"]}],"output":[0,{"description":[0,""],"path":[0,"p5.AudioIn/output"]}],"stream":[0,{"description":[0,""],"path":[0,"p5.AudioIn/stream"]}],"mediaStream":[0,{"description":[0,""],"path":[0,"p5.AudioIn/mediaStream"]}],"currentSource":[0,{"description":[0,""],"path":[0,"p5.AudioIn/currentSource"]}],"enabled":[0,{"description":[0,"<p>Client must allow browser to access their microphone / audioin source.\nDefault: false. Will become true when the client enables access.</p>\n"],"path":[0,"p5.AudioIn/enabled"]}],"amplitude":[0,{"description":[0,"<p>Input amplitude, connect to it by default but not to master out</p>\n"],"path":[0,"p5.AudioIn/amplitude"]}]}],"isConstructor":[0,true],"path":[0,"p5.sound/p5.AudioIn"]}],"render":[0,null]}],"entries":[1,[[0,{"id":[0,"en/p5.AudioIn/amp.mdx"],"slug":[0,"en/p5audioin/amp"],"body":[0,"\n\n# amp\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"amp()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/AudioIn.js"],"description":[0,"Set amplitude (volume) of a mic input between 0 and 1.0."],"line":[0,81],"params":[1,[[0,{"name":[0,"amplitudeAmount"],"description":[0,"An amplitude value between 0 and 1."],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioIn/amp"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/amplitude.mdx"],"slug":[0,"en/p5audioin/amplitude"],"body":[0,"\n\n# amplitude\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"amplitude"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Input amplitude, connect to it by default but not to master out</p>\n"],"line":[0,6098],"itemtype":[0,"property"],"class":[0,"p5.AudioIn"],"isConstructor":[0,false],"path":[0,"p5.AudioIn/amplitude"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/connect.mdx"],"slug":[0,"en/p5audioin/connect"],"body":[0,"\n\n# connect\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"connect()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Connect to an audio unit. If no parameter is provided, will\nconnect to the main output (i.e. your speakers).<br/></p>\n"],"line":[0,6191],"params":[1,[[0,{"name":[0,"unit"],"description":[0,"<p>An object that accepts audio input,\n                        such as an FFT</p>\n"],"type":[0,"Object"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioIn/connect"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/currentSource.mdx"],"slug":[0,"en/p5audioin/currentsource"],"body":[0,"\n\n# currentSource\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"currentSource"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,""],"