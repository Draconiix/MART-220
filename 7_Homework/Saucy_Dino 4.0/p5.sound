moothing is 0.0 by default.\n                             Smooths values based on previous values.</p>\n"],"type":[0,"Number"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"return":[0,{"description":[0,"Volume level (between 0.0 and 1.0)"],"type":[0,"Number"]}],"isConstructor":[0,false],"path":[0,"p5.AudioIn/getLevel"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/getSources.mdx"],"slug":[0,"en/p5audioin/getsources"],"body":[0,"\n\n# getSources\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"getSources()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Returns a list of available input sources. This is a wrapper\nfor <a href=\"https://developer.mozilla.org/\nen-US/docs/Web/API/MediaDevices/enumerateDevices/\" target=\"_blank\">\nMediaDevices.enumerateDevices() - Web APIs | MDN</a>\nand it returns a Promise.</p>\n"],"line":[0,6280],"params":[1,[[0,{"name":[0,"successCallback"],"description":[0,"<p>This callback function handles the sources when they\n                                     have been enumerated. The callback function\n                                     receives the deviceList array as its only argument</p>\n"],"type":[0,"Function"],"optional":[0,true]}],[0,{"name":[0,"errorCallback"],"description":[0,"<p>This optional callback receives the error\n                                   message as its argument.</p>\n"],"type":[0,"Function"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"return":[0,{"description":[0,"Returns a Promise that can be used in place of the callbacks, similar\n                           to the enumerateDevices() method"],"type":[0,"Promise"]}],"example":[1,[[0,"\n <div><code>\n let audioIn;\n\n function setup(){\n   text(&apos;getting sources...&apos;, 0, 20);\n   audioIn = new p5.AudioIn();\n   audioIn.getSources(gotSources);\n }\n\n function gotSources(deviceList) {\n   if (deviceList.length > 0) {\n     //set the source to the first item in the deviceList array\n     audioIn.setSource(0);\n     let currentSource = deviceList[audioIn.currentSource];\n     text(&apos;set source to: &apos; + currentSource.deviceId, 5, 20, width);\n   }\n }\n </code></div>"]]],"isConstructor":[0,false],"path":[0,"p5.AudioIn/getSources"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/input.mdx"],"slug":[0,"en/p5audioin/input"],"body":[0,"\n\n# input\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"input"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,""],"line":[0,6066],"itemtype":[0,"property"],"class":[0,"p5.AudioIn"],"isConstructor":[0,false],"path":[0,"p5.AudioIn/input"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/mediaStream.mdx"],"slug":[0,"en/p5audioin/mediastream"],"body":[0,"\n\n# mediaStream\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"mediaStream"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,""],"line":[0,6080],"itemtype":[0,"property"],"class":[0,"p5.AudioIn"],"isConstructor":[0,false],"path":[0,"p5.AudioIn/mediaStream"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/output.mdx"],"slug":[0,"en/p5audioin/output"],"body":[0,"\n\n# output\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"output"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,""],"line":[0,6070],"itemtype":[0,"property"],"class":[0,"p5.AudioIn"],"isConstructor":[0,false],"path":[0,"p5.AudioIn/output"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/setSource.mdx"],"slug":[0,"en/p5audioin/setsource"],"body":[0,"\n\n# setSource\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"setSource()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Set the input source. Accepts a number representing a\nposition in the array returned by getSources().\nThis is only available in browsers that support\n <a href=\"https://developer.mozilla.org/\n en-US/docs/Web/API/MediaDevices/enumerateDevices/\" target=\"_blank\">\n navigator.mediaDevices.enumerateDevices()</a></p>\n"],"line":[0,6340],"params":[1,[[0,{"name":[0,"num"],"description":[0,"<p>position of input source in the array</p>\n"],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"example":[1,[[0,"\n<div><code>\nlet audioIn;\n\nfunction setup(){\n  text(&apos;getting sources...&apos;, 0, 20);\n  audioIn = new p5.AudioIn();\n  audioIn.getSources(gotSources);\n}\n\nfunction gotSources(deviceList) {\n  if (deviceList.length > 0) {\n    //set the source to the first item in the deviceList array\n    audioIn.setSource(0);\n    let currentSource = deviceList[audioIn.currentSource];\n    text(&apos;set source to: &apos; + currentSource.deviceId, 5, 20, width);\n  }\n}\n</code></div>"]]],"isConstructor":[0,false],"path":[0,"p5.AudioIn/setSource"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/start.mdx"],"slug":[0,"en/p5audioin/start"],"body":[0,"\n\n# start\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"start()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/AudioIn.js"],"description":[0,"Start the audio input."],"line":[0,56],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioIn/start"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/stop.mdx"],"slug":[0,"en/p5audioin/stop"],"body":[0,"\n\n# stop\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"stop()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/AudioIn.js"],"description":[0,"Stop the audio input."],"line":[0,72],"itemtype":[0,"method"],"class":[0,"p5.AudioIn"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioIn/stop"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioIn/stream.mdx"],"slug":[0,"en/p5audioin/stream"],"body":[0,"\n\n# stream\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"stream"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,""],"line":[0,6075],"itemtype":[0,"property"],"class":[0,"p5.AudioIn"],"isConstructor":[0,false],"path":[0,"p5.AudioIn/stream"]}],"render":[0,null]}]]]}],[0,{"name":[0,"p5.AudioVoice"],"entry":[0,{"id":[0,"en/p5.sound/p5.AudioVoice.mdx"],"slug":[0,"en/p5sound/p5audiovoice"],"body":[0,"\n\n# p5.AudioVoice\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.AudioVoice"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Base class for monophonic synthesizers. Any extensions of this class\nshould follow the API and implement the methods below in order to\nremain compatible with p5.PolySynth();</p>\n"],"line":[0,11149],"chainable":[0,false],"methods":[0,{"connect":[0,{"description":[0,"<p>Connect to p5 objects or Web Audio Nodes</p>\n"],"path":[0,"p5.AudioVoice/connect"]}],"disconnect":[0,{"description":[0,"<p>Disconnect from soundOut</p>\n"],"path":[0,"p5.AudioVoice/disconnect"]}]}],"isConstructor":[0,true],"path":[0,"p5.sound/p5.AudioVoice"]}],"render":[0,null]}],"entries":[1,[[0,{"id":[0,"en/p5.AudioVoice/connect.mdx"],"slug":[0,"en/p5audiovoice/connect"],"body":[0,"\n\n# connect\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"connect()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Connect to p5 objects or Web Audio Nodes</p>\n"],"line":[0,11181],"params":[1,[[0,{"name":[0,"unit"],"description":[0,""],"type":[0,"Object"]}]]],"itemtype":[0,"method"],"class":[0,"p5.AudioVoice"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioVoice/connect"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.AudioVoice/disconnect.mdx"],"slug":[0,"en/p5audiovoice/disconnect"],"body":[0,"\n\n# disconnect\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"disconnect()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Disconnect from soundOut</p>\n"],"line":[0,11194],"itemtype":[0,"method"],"class":[0,"p5.AudioVoice"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.AudioVoice/disconnect"]}],"render":[0,null]}]]]}],[0,{"name":[0,"p5.BandPass"],"entry":[0,{"id":[0,"en/p5.sound/p5.BandPass.mdx"],"slug":[0,"en/p5sound/p5bandpass"],"body":[0,"\n\n# p5.BandPass\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.BandPass"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"Creates a Bandpass Biquad filter."],"line":[0,164],"params":[1,[[0,{"name":[0,"freq"],"description":[0,"Set the cutoff frequency of the filter"],"type":[0,"Number"],"optional":[0,true]}]]],"chainable":[0,false],"isConstructor":[0,true],"path":[0,"p5.sound/p5.BandPass"]}],"render":[0,null]}],"entries":[1,[]]}],[0,{"name":[0,"p5.Biquad"],"entry":[0,{"id":[0,"en/p5.sound/p5.Biquad.mdx"],"slug":[0,"en/p5sound/p5biquad"],"body":[0,"\n\n# p5.Biquad\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.Biquad"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"Filter the frequency range of a sound."],"line":[0,11],"params":[1,[[0,{"name":[0,"cutoff"],"description":[0,"cutoff frequency of the filter, a value between 0 and 24000."],"type":[0,"Number"],"optional":[0,true]}],[0,{"name":[0,"type"],"description":[0,"filter type. Options: \"lowpass\", \n                       \"highpass\", \"bandpass\", \"lowshelf\",\n                       \"highshelf\", \"notch\", \"allpass\", \n                       \"peaking\""],"type":[0,"String"],"optional":[0,true]}]]],"chainable":[0,false],"example":[1,[[0,"\n<div>\n<code>\n///kind of Karplus-Strong string synthesis using p5.sound.js\n\nlet noise, lowPass, hiPass, delay, env, gain;\n\nfunction setup() {\n  let cnv = createCanvas(100, 100);\n  background(220);\n  textAlign(CENTER);\n  textSize(9);\n  text(&apos;click and drag mouse&apos;, width/2, height/2);\n  \n  noise = new p5.Noise(&apos;white&apos;);\n  env = new p5.Envelope(0);\n  lowPass = new p5.Biquad(1200, &apos;lowpass&apos;);\n  hiPass = new p5.Biquad(55, &apos;highpass&apos;);\n  delay = new p5.Delay(0.0005, 0.97);\n  gain = new p5.Gain(0.5);\n  noise.disconnect();\n  noise.connect(hiPass);\n  hiPass.disconnect();\n  hiPass.connect(env);\n  env.disconnect();\n  env.connect(lowPass);\n  lowPass.disconnect();\n  lowPass.connect(delay);\n\n  cnv.mousePressed(pluckStart);\n  cnv.mouseReleased(pluckStop);\n  cnv.mouseOut(pluckStop);\n  describe(&apos;A sketch that synthesizes string sounds.&apos;);\n}\n\nfunction pluckStart() {\n  background(0, 255, 255);\n  text(&apos;release to trigger decay&apos;, width/2, height/2);\n  let dtime = map(mouseX, 0, width, 0.009, 0.001);\n  delay.delayTime(dtime, 0);\n  noise.start();\n  env.triggerAttack();\n}\n\nfunction pluckStop() {\n  background(220);\n  text(&apos;click to pluck&apos;, width/2, height/2);\n  env.triggerRelease();\n}\n</code>\n</div>"]]],"methods":[0,{"res":[0,{"description":[0,"The filter&apos;s resonance factor."],"path":[0,"p5.Biquad/res"]}],"gain":[0,{"description":[0,"The gain of the filter in dB units."],"path":[0,"p5.Biquad/gain"]}],"setType":[0,{"description":[0,"Set the type of the filter."],"path":[0,"p5.Biquad/setType"]}],"freq":[0,{"description":[0,"Set the cutoff frequency of the filter."],"path":[0,"p5.Biquad/freq"]}]}],"isConstructor":[0,true],"path":[0,"p5.sound/p5.Biquad"]}],"render":[0,null]}],"entries":[1,[[0,{"id":[0,"en/p5.Biquad/freq.mdx"],"slug":[0,"en/p5biquad/freq"],"body":[0,"\n\n# freq\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"freq()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"Set the cutoff frequency of the filter."],"line":[0,109],"params":[1,[[0,{"name":[0,"cutoffFrequency"],"description":[0,"the cutoff frequency of the filter."],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Biquad"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Biquad/freq"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Biquad/gain.mdx"],"slug":[0,"en/p5biquad/gain"],"body":[0,"\n\n# gain\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"gain()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"The gain of the filter in dB units."],"line":[0,89],"params":[1,[[0,{"name":[0,"gain"],"description":[0,"gain value in dB units. The gain is only used for lowshelf, highshelf, and peaking filters."],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Biquad"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Biquad/gain"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Biquad/res.mdx"],"slug":[0,"en/p5biquad/res"],"body":[0,"\n\n# res\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"res()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"The filter&apos;s resonance factor."],"line":[0,79],"params":[1,[[0,{"name":[0,"resonance"],"description":[0,"resonance of the filter. A number between 0 and 100."],"type":[0,"Number"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Biquad"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Biquad/res"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Biquad/setType.mdx"],"slug":[0,"en/p5biquad/settype"],"body":[0,"\n\n# setType\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"setType()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"src/Biquad.js"],"description":[0,"Set the type of the filter."],"line":[0,99],"params":[1,[[0,{"name":[0,"type"],"description":[0,"type of the filter. Options: \"lowpass\", \"highpass\", \"bandpass\", \"lowshelf\", \"highshelf\", \"notch\", \"allpass\", \"peaking\""],"type":[0,"String"]}]]],"itemtype":[0,"method"],"class":[0,"p5.Biquad"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Biquad/setType"]}],"render":[0,null]}]]]}],[0,{"name":[0,"p5.Compressor"],"entry":[0,{"id":[0,"en/p5.sound/p5.Compressor.mdx"],"slug":[0,"en/p5sound/p5compressor"],"body":[0,"\n\n# p5.Compressor\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"p5.Compressor"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Compressor is an audio effect class that performs dynamics compression\non an audio input source. This is a very commonly used technique in music\nand sound production. Compression creates an overall louder, richer,\nand fuller sound by lowering the volume of louds and raising that of softs.\nCompression can be used to avoid clipping (sound distortion due to\npeaks in volume) and is especially useful when many sounds are played\nat once. Compression can be used on indivudal sound sources in addition\nto the main output.</p>\n<p>This class extends <a href=\"/reference//p5.Effect\">p5.Effect</a>.\nMethods <a href=\"/reference//p5.Effect/amp/\">amp()</a>, <a href=\"/reference//p5.Effect/chain/\">chain()</a>,\n<a href=\"/reference//p5.Effect/drywet/\">drywet()</a>, <a href=\"/reference//p5.Effect/connect/\">connect()</a>, and\n<a href=\"/reference//p5.Effect/disconnect/\">disconnect()</a> are available.</p>\n"],"line":[0,10036],"chainable":[0,false],"methods":[0,{"process":[0,{"description":[0,"<p>Performs the same function as .connect, but also accepts\noptional parameters to set compressor&apos;s audioParams</p>\n"],"path":[0,"p5.Compressor/process"]}],"set":[0,{"description":[0,"<p>Set the paramters of a compressor.</p>\n"],"path":[0,"p5.Compressor/set"]}],"attack":[0,{"description":[0,"<p>Get current attack or set value w/ time ramp</p>\n"],"path":[0,"p5.Compressor/attack"]}],"knee":[0,{"description":[0,"<p>Get current knee or set value w/ time ramp</p>\n"],"path":[0,"p5.Compressor/knee"]}],"ratio":[0,{"description":[0,"<p>Get current ratio or set value w/ time ramp</p>\n"],"path":[0,"p5.Compressor/ratio"]}],"threshold":[0,{"description":[0,"<p>Get current threshold or set value w/ time ramp</p>\n"],"path":[0,"p5.Compressor/threshold"]}],"release":[0,{"description":[0,"<p>Get current release or set value w/ time ramp</p>\n"],"path":[0,"p5.Compressor/release"]}],"reduction":[0,{"description":[0,"<p>Return the current reduction value</p>\n"],"path":[0,"p5.Compressor/reduction"]}]}],"properties":[0,{"compressor":[0,{"description":[0,"<p>The p5.Compressor is built with a <a href=\"https://www.w3.org/TR/webaudio/#the-dynamicscompressornode-interface\" target=\"_blank\" title=\"W3 spec for Dynamics Compressor Node\">Web Audio Dynamics Compressor Node\n   </a></p>\n"],"path":[0,"p5.Compressor/compressor"]}]}],"isConstructor":[0,true],"path":[0,"p5.sound/p5.Compressor"]}],"render":[0,null]}],"entries":[1,[[0,{"id":[0,"en/p5.Compressor/attack.mdx"],"slug":[0,"en/p5compressor/attack"],"body":[0,"\n\n# attack\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"attack()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Get current attack or set value w/ time ramp</p>\n"],"line":[0,10152],"params":[1,[[0,{"name":[0,"attack"],"description":[0,"<p>Attack is the amount of time (in seconds) to reduce the gain by 10dB,\n                         default = .003, range 0 - 1</p>\n"],"type":[0,"Number"],"optional":[0,true]}],[0,{"name":[0,"time"],"description":[0,"<p>Assign time value to schedule the change in value</p>\n"],"type":[0,"Number"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.Compressor"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Compressor/attack"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Compressor/compressor.mdx"],"slug":[0,"en/p5compressor/compressor"],"body":[0,"\n\n# compressor\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"compressor"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>The p5.Compressor is built with a <a href=\"https://www.w3.org/TR/webaudio/#the-dynamicscompressornode-interface\" target=\"_blank\" title=\"W3 spec for Dynamics Compressor Node\">Web Audio Dynamics Compressor Node\n   </a></p>\n"],"line":[0,10068],"itemtype":[0,"property"],"class":[0,"p5.Compressor"],"isConstructor":[0,false],"path":[0,"p5.Compressor/compressor"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Compressor/knee.mdx"],"slug":[0,"en/p5compressor/knee"],"body":[0,"\n\n# knee\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"knee()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Get current knee or set value w/ time ramp</p>\n"],"line":[0,10178],"params":[1,[[0,{"name":[0,"knee"],"description":[0,"<p>A decibel value representing the range above the\n                       threshold where the curve smoothly transitions to the \"ratio\" portion.\n                       default = 30, range 0 - 40</p>\n"],"type":[0,"Number"],"optional":[0,true]}],[0,{"name":[0,"time"],"description":[0,"<p>Assign time value to schedule the change in value</p>\n"],"type":[0,"Number"],"optional":[0,true]}]]],"itemtype":[0,"method"],"class":[0,"p5.Compressor"],"chainable":[0,false],"isConstructor":[0,false],"path":[0,"p5.Compressor/knee"]}],"render":[0,null]}],[0,{"id":[0,"en/p5.Compressor/process.mdx"],"slug":[0,"en/p5compressor/process"],"body":[0,"\n\n# process\n"],"collection":[0,"reference"],"data":[0,{"title":[0,"process()"],"module":[0,"p5.sound"],"submodule":[0,"p5.sound"],"file":[0,"lib/addons/p5.sound.js"],"description":[0,"<p>Performs the same function as .connect, but also accepts\noptional parameters to set compressor&apos;s audioParams</p>\n"],"line":[0,10084],"params":[1,[[0,{"name":[0,"src"],"description":[0,"<p>Sound source to be connected</p>\n"],"type":[0,"Object"]}],[0,{"name":[0,"attack"],"description":[0,"<p>The amount of time (in seconds) to reduce the gain by